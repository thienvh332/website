<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.portal.content.only</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='website_settings']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="portal_content_only_toggle_enabled" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="portal_content_only_toggle_enabled" />
                        <div class="text-muted">
                            Show toggle button on portal pages to hide/show header and footer
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
